---
import { getCollection } from 'astro:content';
import { SITE, NAV } from '../site.config';

const publishedPosts = await getCollection('blog', ({ data }) => !data.draft);
const nav = publishedPosts.length > 0 ? [...NAV, { href: '/blog/', label: 'Blog' }] : [...NAV];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <nav aria-label="Main" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      {SITE.name}
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="group relative py-1 text-sm font-medium text-fg"
            >
              {item.label}
              <span
                class:list={[
                  'absolute inset-x-0 -bottom-0.5 h-0.5 origin-left bg-accent transition-transform duration-150',
                  isActive(item.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                ]}
              />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Switch to dark theme"
        class="theme-toggle"
      >
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" class="icon-moon">
          <path
            d="M13 9.4A5.9 5.9 0 0 1 5.6 2 5.9 5.9 0 1 0 13 9.4Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        <span class="track" aria-hidden="true"><span class="knob"></span></span>
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" class="icon-sun">
          <circle cx="7.5" cy="7.5" r="3" stroke="currentColor" stroke-width="1.4" />
          <path
            d="M7.5 1v1.5M7.5 12.5V14M14 7.5h-1.5M2.5 7.5H1M12.1 2.9l-1 1M3.9 11.1l-1 1M12.1 12.1l-1-1M3.9 3.9l-1-1"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <a
        href="/contact/"
        class="hidden rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast transition-transform duration-200 hover:-translate-y-0.5 md:inline-block"
      >
        Book a call
      </a>

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        class="grid h-11 w-11 place-items-center rounded-full border border-line md:hidden"
      >
      <span class="sr-only">Toggle menu</span>
      <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg id="nav-icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="hidden">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      </button>
    </div>
  </nav>

  <div id="nav-panel" hidden class="border-t border-line px-5 py-4 md:hidden">
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block rounded-lg px-3 py-3 text-base font-medium text-fg aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2">
        <a
          href="/contact/"
          class="block rounded-full bg-accent px-4 py-3 text-center text-base font-semibold text-accent-contrast"
        >
          Book a call
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem; /* 44px touch target */
    padding: 0 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--muted);
  }
  .theme-toggle .track {
    position: relative;
    width: 2.5rem;
    height: 1.375rem;
    border-radius: 999px;
    background: var(--line);
    transition: background-color 0.2s ease;
  }
  /* knob points at the active icon: moon (left) in dark, sun (right) in light */
  .theme-toggle .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--fg);
    transition: left 0.2s ease;
  }
  .theme-toggle[data-state='light'] .knob {
    left: calc(100% - 1rem - 3px);
  }
  .theme-toggle[data-state='light'] .icon-sun,
  .theme-toggle[data-state='dark'] .icon-moon {
    color: var(--fg);
  }
</style>

<script>
  /* ── Theme toggle (PRD §4 localStorage exclusion amended 2026-07-29) ──
     No stored choice → follow the system; after the visitor's first click,
     their choice wins and persists. The pre-paint script in BaseLayout
     applies the stored value before CSS renders. */
  const themeBtn = document.getElementById('theme-toggle')!;
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');
  const THEME_BG = { light: '#f4f5f2', dark: '#101319' } as const;

  function effectiveTheme(): 'light' | 'dark' {
    const forced = document.documentElement.dataset.theme;
    if (forced === 'light' || forced === 'dark') return forced;
    return darkQuery.matches ? 'dark' : 'light';
  }

  function renderThemeButton() {
    const t = effectiveTheme();
    themeBtn.dataset.state = t;
    themeBtn.setAttribute('aria-pressed', String(t === 'dark'));
    themeBtn.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  }

  themeBtn.addEventListener('click', () => {
    const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private-mode etc. — toggle still works for this page */
    }
    // keep the browser-chrome tint in sync with the forced theme
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((m) => m.setAttribute('content', THEME_BG[next]));
    renderThemeButton();
  });

  // if the visitor is on "auto" and their OS theme flips, keep the knob honest
  darkQuery.addEventListener('change', renderThemeButton);
  renderThemeButton();

  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('nav-panel')!;
  const iconOpen = document.getElementById('nav-icon-open')!;
  const iconClose = document.getElementById('nav-icon-close')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
