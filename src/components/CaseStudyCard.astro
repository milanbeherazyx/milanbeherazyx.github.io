---
import Tag from './Tag.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  tags: readonly string[];
  metric?: { value: string; label: string };
}
const { href, title, summary, tags, metric } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="group block rounded-2xl border-t-[3px] border-fg pt-6 transition-transform duration-200 hover:-translate-y-1"
>
  <div class="flex flex-wrap gap-2">
    {tags.map((t) => <Tag label={t} />)}
  </div>
  <h3 class="mt-5 max-w-[24ch] font-display text-2xl font-semibold leading-tight tracking-tight sm:text-[1.65rem]">
    {title}
  </h3>
  {
    metric && (
      <p class="mt-3 font-display text-lg font-semibold tabular text-accent">
        {metric.value} <span class="font-body text-sm font-normal text-muted">{metric.label}</span>
      </p>
    )
  }
  <p class="mt-3 max-w-[38ch] text-[0.98rem] text-muted">{summary}</p>
  <span class="mt-5 inline-block border-b-2 border-fg pb-0.5 text-sm font-semibold group-hover:border-accent group-hover:text-accent">
    Read the case study →
  </span>
</a>
