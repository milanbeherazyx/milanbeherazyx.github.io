---
/**
 * Signature element — "Before / After" (locked funnel treatment) matching
 * the approved c-signal.html mock: glass surface, gradient border-beam,
 * scroll-triggered bar fill (indigo "before", full-gradient "after" with a
 * violet bloom), spring-popped delta chip, and a real count-up on both
 * numerals (clean integer props — see ProofStrip for why its
 * compound-string values don't get literal digit count-up). Numbers are
 * props so this stays reusable without ever inventing data (PRD §7).
 *
 * ⚠️ Selectors that start from the html-level `.js` class MUST be written
 * as `:global(.js)` here: Astro scopes component styles by suffixing every
 * selector part with [data-astro-cid-*], and `<html>` never carries that
 * attribute — a plain `.js ...` descendant rule silently never matches.
 * (Real bug: bars stayed at width 0 and the chip at opacity 0 in G3.)
 */
interface Props {
  beforeValue: number;
  afterValue: number;
  of: number;
  beforeLabel: string;
  afterLabel: string;
  deltaLabel: string;
  footnote?: string;
}

const { beforeValue, afterValue, of, beforeLabel, afterLabel, deltaLabel, footnote } = Astro.props;
const beforePct = (beforeValue / of) * 100;
const afterPct = (afterValue / of) * 100;
---

<div data-reveal class="funnel-card glass beam p-6 sm:p-8">
  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-mono">
      <span class="text-label text-muted">{beforeLabel}</span>
      <span class="fig font-display font-bold tabular"
        ><span class="count" data-count={beforeValue}>0</span><span class="fig-small text-muted">/{of}</span></span
      >
    </div>
    <div class="track mt-2 overflow-hidden rounded-lg border border-line">
      <div class="fill" style={`--pct:${beforePct}%`}></div>
    </div>
  </div>

  <div class="mt-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-mono">
      <span class="text-label text-accent-2">{afterLabel}</span>
      <span class="fig font-display font-bold tabular text-accent-2"
        ><span class="count" data-count={afterValue}>0</span><span class="fig-small text-muted">/{of}</span></span
      >
    </div>
    <div class="track mt-2 overflow-hidden rounded-lg border border-line">
      <div class="fill fill-after" style={`--pct:${afterPct}%`}></div>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <span class="delta-chip inline-flex items-center gap-1 rounded-full border border-accent-2/45 bg-accent-2/10 px-4 py-1.5 font-mono text-sm font-semibold text-accent-2">
      Δ {deltaLabel}
    </span>
    {footnote && <p class="text-sm text-muted">{footnote}</p>}
  </div>
</div>

<style>
  .fig {
    font-size: clamp(1.7rem, 1rem + 2vw, 2.4rem);
    line-height: 1.1;
  }
  .fig-small {
    font-size: 0.55em;
    font-weight: 500;
  }
  .track {
    height: 40px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  .fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #3f4894, #565fd8);
    transition: width 1.1s var(--ease-rise) 0.1s;
  }
  .fill-after {
    background: var(--gradient);
    box-shadow: 0 0 22px -2px rgba(124, 93, 250, 0.8);
    transition-delay: 0.35s;
  }
  :global(.js) [data-reveal].is-revealed .fill {
    width: var(--pct);
  }
  .delta-chip {
    opacity: 0;
    transform: translateY(8px) scale(0.9);
    transition:
      opacity 0.5s ease 0.9s,
      transform 0.5s var(--ease-spring) 0.9s;
  }
  :global(.js) [data-reveal].is-revealed .delta-chip {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fill {
      width: var(--pct) !important;
    }
    .delta-chip {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { countUpOnView } from '../scripts/motion-lib';

  document.querySelectorAll<HTMLElement>('.funnel-card .count[data-count]').forEach((el) => {
    const target = Number(el.dataset.count);
    if (!Number.isNaN(target)) countUpOnView(el, target);
  });
</script>
