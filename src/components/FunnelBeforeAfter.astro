---
/**
 * Signature element — "Before / After" (locked funnel treatment) rebuilt
 * for the v2 "Signal" direction: glass surface, gradient border-beam,
 * scroll-triggered bar fill, and a real count-up on both numerals (clean
 * integer props — see ProofStrip for why its compound-string values don't
 * get literal digit count-up). Numbers are props so this stays reusable
 * without ever inventing data (PRD §7).
 */
interface Props {
  beforeValue: number;
  afterValue: number;
  of: number;
  beforeLabel: string;
  afterLabel: string;
  deltaLabel: string;
  footnote?: string;
}

const { beforeValue, afterValue, of, beforeLabel, afterLabel, deltaLabel, footnote } = Astro.props;
const beforePct = (beforeValue / of) * 100;
const afterPct = (afterValue / of) * 100;
---

<div data-reveal class="funnel-card glass beam p-6 sm:p-8">
  <div class="flex flex-col gap-6">
    <div>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <span class="text-label text-muted">{beforeLabel}</span>
        <span class="font-display text-2xl font-bold tabular sm:text-3xl"
          ><span class="count" data-count={beforeValue}>0</span><span class="text-muted">/{of}</span></span
        >
      </div>
      <div class="mt-2 h-11 overflow-hidden rounded-md bg-line">
        <div class="fill flex h-full items-center justify-end bg-muted px-3" style={`--pct:${beforePct}%`}>
          <span class="font-mono text-xs font-semibold text-bg">{beforeValue}</span>
        </div>
      </div>
    </div>

    <div>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <span class="text-label text-accent-2">{afterLabel}</span>
        <span class="font-display text-2xl font-bold tabular text-accent-2 sm:text-3xl"
          ><span class="count" data-count={afterValue}>0</span><span class="text-muted">/{of}</span></span
        >
      </div>
      <div class="mt-2 h-11 overflow-hidden rounded-md bg-line">
        <div class="fill fill-accent flex h-full items-center justify-end px-3" style={`--pct:${afterPct}%`}>
          <span class="font-mono text-xs font-semibold text-accent-contrast">{afterValue}</span>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="delta-chip inline-flex items-center gap-1 rounded-full border border-accent-2/40 bg-accent-2/10 px-3 py-1.5 font-mono text-sm font-semibold text-accent-2">
        Δ {deltaLabel}
      </span>
      {footnote && <p class="text-sm text-muted">{footnote}</p>}
    </div>
  </div>
</div>

<style>
  .fill {
    width: 0%;
    border-radius: 0.375rem 0 0 0.375rem;
    transition: width 1.1s var(--ease-rise) 0.1s;
  }
  .fill-accent {
    background: var(--gradient);
    box-shadow: 0 0 18px -4px var(--accent-2);
    transition-delay: 0.35s;
  }
  .js [data-reveal].is-revealed .fill {
    width: var(--pct);
  }
  .delta-chip {
    opacity: 0;
    transform: translateY(8px) scale(0.9);
    transition:
      opacity 0.4s ease 0.9s,
      transform 0.4s var(--ease-spring) 0.9s;
  }
  .js [data-reveal].is-revealed .delta-chip {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fill {
      width: var(--pct) !important;
    }
    .delta-chip {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { countUpOnView } from '../scripts/motion-lib';

  document.querySelectorAll<HTMLElement>('.funnel-card .count[data-count]').forEach((el) => {
    const target = Number(el.dataset.count);
    if (!Number.isNaN(target)) countUpOnView(el, target);
  });
</script>
