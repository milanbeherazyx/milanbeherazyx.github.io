---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for a page-specific OG image. Falls back to the
   *  shared default (public/og-default.jpg) when omitted. */
  image?: string;
  /** Optional page-specific JSON-LD (e.g. Article + breadcrumbs on case
   *  studies, ProfilePage on About). An array is valid JSON-LD too
   *  (multiple top-level items, e.g. OfferCatalog + FAQPage on Services).
   *  Rendered as a second ld+json script. */
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep utility pages (e.g. /thanks/) out of search results. */
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/og-default.jpg',
  extraSchema,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url).toString();
const imageURL = new URL(image, SITE.url).toString();

/**
 * Site-wide JSON-LD graph (PRD §4 SEO row): Person + WebSite with stable
 * @ids so page-level schemas (Article, ProfilePage) can reference the same
 * entity instead of redefining it. Every fact here is ✅ PUBLIC per
 * content-pack §1/§4/§6/§7 (city-level location only, no phone/address).
 */
const PERSON_ID = `${SITE.url}/#person`;
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Milan Kumar Behera',
      alternateName: ['Milan Behera', 'milanbeherazyx'],
      url: SITE.url,
      image: imageURL,
      email: `mailto:${SITE.email}`,
      jobTitle: 'Data Analyst',
      description: SITE.description,
      worksFor: { '@type': 'Organization', name: 'Khatabook' },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Einstein Academy of Technology & Management (BPUT)',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bengaluru',
        addressRegion: 'Karnataka',
        addressCountry: 'IN',
      },
      knowsAbout: [
        'Data Analytics',
        'Lending & Credit Risk Analytics',
        'Business Rules Engine (BRE) Policy Analytics',
        'Credit Underwriting Policy Configuration',
        'Approval Funnel Analysis',
        'Root-Cause Analysis',
        'Risk Cohort & Vintage Analysis',
        'Delinquency Monitoring & Early Warning Indicators',
        'SQL',
        'Snowflake',
        'Tableau',
        'Power BI',
        'Python',
        'Machine Learning',
        'Data Visualization & Dashboard Development',
        'A/B Testing',
        'ETL Pipelines & REST API Integration',
        'Regulatory & Compliance Reporting',
      ],
      sameAs: [SITE.socials.linkedin, SITE.socials.github, SITE.socials.x],
      /* Freelance intent (PRD lead-gen goal): each service offered
       * remotely, worldwide — names mirror src/content/services titles. */
      makesOffer: [
        'Funnel & conversion diagnostics',
        'Metrics, dashboards & data QA',
        'Rules & policy analytics',
        'Root-cause analysis on metric movements',
      ].map((name) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name,
          provider: { '@id': PERSON_ID },
          serviceType: 'Data analytics consulting',
          areaServed: 'Worldwide',
        },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': PERSON_ID },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* Theme choice must apply BEFORE first paint (no wrong-theme flash),
         so this runs inline at the very top of <head>. No stored choice =
         no attribute = CSS follows the system preference. */
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Milan Kumar Behera" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }

    <!-- Self-hosted display/body fonts: preload so hero text (the LCP
         element) paints without a font-fetch waterfall. -->
    <link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Milan Kumar Behera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:creator" content={SITE.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    {extraSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}

    <!-- Umami Cloud analytics (PRD §12.2) -->
    {
      SITE.umamiWebsiteId && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={SITE.umamiWebsiteId}
        />
      )
    }
  </head>
  <body class="min-h-dvh bg-bg font-body text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <script src="../scripts/motion.ts"></script>
  </body>
</html>
