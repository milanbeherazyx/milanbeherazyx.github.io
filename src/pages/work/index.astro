---
// Case-study index (PRD §3.2) — filterable by tag, vanilla JS (no framework).
// v2 "Signal": staggered card reveal, gradient-pressed filter chips with
// press physics + per-tag counts.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const studies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const allTags = ['Funnel', 'Policy', 'Risk', 'Dashboard', 'SQL', 'Tooling'] as const;
const usedTags = allTags
  .map((t) => ({ tag: t, count: studies.filter((s) => s.data.tags.includes(t)).length }))
  .filter((t) => t.count > 0);
---

<BaseLayout title="Case studies — Milan Kumar Behera" description="Lending and credit-risk analytics case studies, plus proof of range across other domains.">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 data-rise style="--rise-i:0" class="text-h2 font-display">Case studies</h1>
    <p data-rise style="--rise-i:1" class="mt-4 max-w-[42ch] text-muted">
      Each one follows the same memo: context, problem, approach, what I built, outcome, tools —
      and where else the technique applies.
    </p>

    {
      studies.length === 0 ? (
        <p class="mt-10 text-muted">Case studies are being written — check back soon.</p>
      ) : (
        <Fragment>
          {usedTags.length > 0 && (
            <div id="tag-filters" class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by tag">
              <button type="button" data-tag="all" aria-pressed="true" class="filter-btn">
                All <span class="count">{studies.length}</span>
              </button>
              {usedTags.map(({ tag, count }) => (
                <button type="button" data-tag={tag} aria-pressed="false" class="filter-btn">
                  {tag} <span class="count">{count}</span>
                </button>
              ))}
            </div>
          )}

          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            {studies.map((s, i) => (
              <div class="case-item" data-tags={s.data.tags.join(',')}>
                <CaseStudyCard
                  href={`/work/${s.id}/`}
                  title={s.data.title}
                  summary={s.data.summary}
                  tags={s.data.tags}
                  metric={s.data.metrics?.[0]}
                  index={i + 1}
                  delay={i * 60}
                />
              </div>
            ))}
          </div>
        </Fragment>
      )
    }
  </section>
</BaseLayout>

<style>
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    min-height: 2.75rem;
    transition:
      transform 0.15s var(--ease-spring),
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .filter-btn:active {
    transform: scale(0.94);
  }
  .filter-btn .count {
    font-size: 0.7rem;
    opacity: 0.7;
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--gradient);
    border-color: transparent;
    color: #fff;
  }
  .filter-btn[aria-pressed='true'] .count {
    opacity: 0.85;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#tag-filters .filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.case-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const tag = btn.dataset.tag!;
      items.forEach((item) => {
        const tags = item.dataset.tags?.split(',') ?? [];
        item.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none';
      });
    });
  });
</script>
