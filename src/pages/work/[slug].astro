---
// Case-study detail (PRD §3.2) — memo layout. Body markdown supplies the
// strict section order (Context → Problem → Approach → What I built →
// Outcome → Tools); frontmatter supplies header metrics + the closing
// "Where else this applies" note (never invented — content_pack.md only).
// v2 "Signal": reading-progress hairline, section-heading slide-reveals,
// metric rule draw-in (no literal digit count-up — same reasoning as
// ProofStrip: these are approved compound strings like "30% → 43%" and
// "200+", and parsing them to animate digits risks altering approved copy).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const studies = await getCollection('work', ({ data }) => !data.draft);
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);

import { SITE } from '../../site.config';
const pageURL = `${SITE.url}/work/${study.id}/`;
const caseStudySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: study.data.title,
      description: study.data.summary,
      url: pageURL,
      mainEntityOfPage: pageURL,
      image: `${SITE.url}/og-default.jpg`,
      author: { '@id': `${SITE.url}/#person` },
      publisher: { '@id': `${SITE.url}/#person` },
      keywords: [...study.data.tags, ...study.data.tools].join(', '),
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Case studies', item: `${SITE.url}/work/` },
        { '@type': 'ListItem', position: 3, name: study.data.title, item: pageURL },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${study.data.title} — Milan Kumar Behera`}
  description={study.data.summary}
  extraSchema={caseStudySchema}
>
  <div id="reading-progress" class="fixed inset-x-0 top-0 z-50 h-0.75 origin-left scale-x-0 bg-fg"></div>

  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <a href="/work/" class="text-sm font-semibold text-muted hover:text-accent-2">← All case studies</a>

    <div class="mt-6 flex flex-wrap gap-2">
      {study.data.tags.map((t) => <Tag label={t} />)}
    </div>

    <h1 class="mt-5 max-w-[20ch] text-h2 font-display">{study.data.title}</h1>
    <p class="mt-4 text-lead text-muted">{study.data.summary}</p>

    {
      study.data.metrics && study.data.metrics.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-8">
          {study.data.metrics.map((m, i) => (
            <div data-reveal style={`transition-delay:${i * 90}ms`} class="metric-item relative pt-5">
              <span class="rule-draw absolute inset-x-0 top-0 h-0.5 origin-left bg-linear-to-r from-accent to-accent-2" />
              <p class="font-display text-2xl font-bold tabular-nums text-gradient">{m.value}</p>
              <p class="mt-1 text-sm text-muted">{m.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <div class="case-content mt-10">
      <Content />
    </div>

    <div data-reveal class="glass beam mt-12 p-6">
      <p class="text-label text-accent-2">Where else this applies</p>
      <p class="mt-2 text-fg">{study.data.whereElseThisApplies}</p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2">
      {study.data.tools.map((t) => <Tag label={t} />)}
    </div>

    <a href="/contact/" class="btn-gradient mt-12 inline-block px-6 py-3 font-semibold">
      Discuss a similar problem →
    </a>
  </article>
</BaseLayout>

<style>
  .case-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.5s var(--ease-rise),
      transform 0.5s var(--ease-rise);
  }
  .case-content :global(h2.heading-revealed) {
    opacity: 1;
    transform: none;
  }
  .case-content :global(h2:first-child) {
    margin-top: 0;
  }
  .case-content :global(p) {
    color: var(--fg);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .case-content :global(em) {
    color: var(--muted);
  }
  .case-content :global(a) {
    color: var(--accent-2);
    text-decoration: underline;
  }
  .case-content :global(strong) {
    font-weight: 600;
  }
  .case-content :global(ul) {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .case-content :global(li) {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.85rem;
    line-height: 1.7;
  }
  .case-content :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 2px;
    background: var(--gradient);
  }
  .case-content :global(li:last-child) {
    margin-bottom: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .case-content :global(h2) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Reading-progress hairline. Self-contained (own rAF-throttled scroll
  // listener), not tied to the reduced-motion-gated reveal system — it's a
  // continuous position indicator, not a one-shot animation, so it stays
  // functional (instantly, no easing) even under reduced-motion.
  const bar = document.getElementById('reading-progress')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    bar.style.transition = 'transform 0.1s linear';
  }
  let ticking = false;
  function updateProgress() {
    const article = document.querySelector('article')!;
    const total = article.scrollHeight - window.innerHeight;
    const progress = total > 0 ? Math.min(window.scrollY / total, 1) : 0;
    bar.style.transform = `scaleX(${progress})`;
    ticking = false;
  }
  document.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    },
    { passive: true },
  );
  updateProgress();

  // Section-heading slide-reveal — self-contained observer (doesn't depend
  // on the global motion.ts script's querySelectorAll timing).
  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('heading-revealed');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.3, rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.case-content h2').forEach((h) => io.observe(h));
  } else {
    document.querySelectorAll('.case-content h2').forEach((h) => h.classList.add('heading-revealed'));
  }
</script>
