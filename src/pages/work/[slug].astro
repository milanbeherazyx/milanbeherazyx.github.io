---
// Case-study detail (PRD §3.2) — STUB template. Phase 3 builds the real
// memo-style layout enforcing the section order.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studies = await getCollection('work', ({ data }) => !data.draft);
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout title={`${study.data.title} — Milan Behera`} description={study.data.summary}>
  <article class="prose max-w-prose">
    <h1>{study.data.title}</h1>
    <p>{study.data.summary}</p>
    <Content />
    <h2>Where else this applies</h2>
    <p>{study.data.whereElseThisApplies}</p>
  </article>
</BaseLayout>
