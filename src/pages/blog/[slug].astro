---
// Blog post detail (PRD §3.7) — upgraded for the v2.1 SEO content sprint:
// BlogPosting + breadcrumb JSON-LD, visible pubDate, full long-form
// typography incl. code blocks (method posts carry SQL/Python), reading
// progress, and an end-of-post conversion CTA into services/contact.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageURL = `${SITE.url}/blog/${post.id}/`;
const postSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      url: pageURL,
      mainEntityOfPage: pageURL,
      image: `${SITE.url}/og-default.jpg`,
      datePublished: post.data.pubDate.toISOString(),
      author: { '@id': `${SITE.url}/#person` },
      publisher: { '@id': `${SITE.url}/#person` },
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: pageURL },
      ],
    },
  ],
};

const dateLabel = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} — Milan Kumar Behera`} description={post.data.description} extraSchema={postSchema}>
  <div id="reading-progress" class="fixed inset-x-0 top-0 z-50 h-0.75 origin-left scale-x-0 bg-fg"></div>

  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <a href="/blog/" class="textlink">← all_posts</a>
    <p class="mt-6 font-mono text-sm text-muted">{dateLabel}</p>
    <h1 class="mt-3 text-h2 font-display">{post.data.title}</h1>
    <p class="mt-4 text-lead text-muted">{post.data.description}</p>

    <div class="post-content mt-10">
      <Content />
    </div>

    <div data-reveal class="glass mt-14 p-6 sm:p-8">
      <p class="text-label text-accent-2">Working on something similar?</p>
      <p class="mt-2 max-w-[52ch] text-muted">
        This is the kind of problem I take on as a freelance analyst — remote, worldwide. The case
        studies show the method end-to-end.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-4 sm:gap-6">
        <a href="/contact/" class="btn-gradient inline-block px-6 py-3 font-semibold">Book a call</a>
        <a href="/work/" class="textlink">read_the_case_studies →</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .post-content :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
  }
  .post-content :global(p) {
    color: var(--fg);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .post-content :global(em) {
    color: var(--muted);
  }
  .post-content :global(a) {
    color: var(--accent-2);
    text-decoration: underline;
  }
  .post-content :global(strong) {
    font-weight: 600;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }
  .post-content :global(ul) {
    list-style: none;
    padding: 0;
  }
  .post-content :global(ul > li) {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.85rem;
    line-height: 1.7;
  }
  .post-content :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 2px;
    background: var(--gradient);
  }
  .post-content :global(ol) {
    list-style: decimal; /* Tailwind preflight unstyles lists */
  }
  .post-content :global(ol > li) {
    margin-bottom: 0.85rem;
    line-height: 1.7;
  }
  /* Code — method posts carry SQL/Python. Fenced blocks get a console
   * panel; inline code a subtle chip. Shiki (Astro default) supplies its
   * own token colors inline; we only shape the container. */
  .post-content :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    margin: 0 0 1.25rem;
    overflow-x: auto;
  }
  .post-content :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }
  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent-2);
    padding-left: 1.1rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 0 0 1.25rem;
  }
  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .post-content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>

<script>
  // Reading-progress hairline — same self-contained pattern as the case
  // study template (rAF-throttled, functional under reduced motion).
  const bar = document.getElementById('reading-progress')!;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    bar.style.transition = 'transform 0.1s linear';
  }
  let ticking = false;
  function updateProgress() {
    const article = document.querySelector('article')!;
    const total = article.scrollHeight - window.innerHeight;
    const progress = total > 0 ? Math.min(window.scrollY / total, 1) : 0;
    bar.style.transform = `scaleX(${progress})`;
    ticking = false;
  }
  document.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    },
    { passive: true },
  );
  updateProgress();
</script>
