---
// Blog index (PRD §3.7) — structure only in v1. Route exists but stays out
// of the nav until ≥1 published post exists (BaseLayout/SiteHeader handles that).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog — Milan Kumar Behera">
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="text-h2 font-display">Blog</h1>
    {
      posts.length === 0 ? (
        <p class="mt-6 text-muted">No posts yet — check back soon.</p>
      ) : (
        <ul class="mt-10 space-y-8">
          {posts.map((p) => (
            <li class="border-t border-line pt-6">
              <a href={`/blog/${p.id}/`} class="font-display text-xl font-semibold hover:text-accent">
                {p.data.title}
              </a>
              <p class="mt-2 text-sm text-muted">{p.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
