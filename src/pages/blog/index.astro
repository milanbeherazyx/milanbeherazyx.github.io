---
// Blog index (PRD §3.7) — structure only in v1. Route exists but stays out
// of the nav until ≥1 published post exists (BaseLayout/SiteHeader handles that).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog — Milan Kumar Behera"
  description="Notes on data analytics, lending and credit risk, and the method behind the case studies — from Milan Kumar Behera."
>
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="text-h2 font-display">Blog</h1>
    {
      posts.length === 0 ? (
        <p class="mt-6 text-muted">No posts yet — check back soon.</p>
      ) : (
        <ul class="mt-10 space-y-6">
          {posts.map((p, i) => (
            <li data-reveal style={i ? `transition-delay:${i * 60}ms` : undefined} class="glass lift p-6">
              <p class="font-mono text-xs text-muted">
                {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
              <a href={`/blog/${p.id}/`} class="mt-2 inline-block font-display text-xl font-semibold hover:text-accent-2">
                {p.data.title}
              </a>
              <p class="mt-2 text-sm text-muted">{p.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
