---
// Blog index (PRD §3.7) — structure only in v1. Route exists but is not in
// the nav until ≥1 published post exists (BaseLayout handles that).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog — Milan Behera">
  <h1 class="text-3xl font-bold">Blog</h1>
  {
    posts.length === 0 ? (
      <p class="mt-4">No posts yet.</p>
    ) : (
      <ul class="mt-6 space-y-4">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="underline">
              {p.data.title}
            </a>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
