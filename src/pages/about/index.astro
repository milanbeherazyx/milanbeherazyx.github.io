---
// About (PRD §3.4). Bio (placeholder — Phase 4 writes full prose from a bio
// Milan supplies), photo, tools grid (all facts from content_pack.md §6,
// already approved — safe to finalize now), recommendations as typed
// pull-quotes linking to LinkedIn for verification (no screenshots).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
import photo from '../../assets/milan-photo.png';

const recs = (await getCollection('recommendations', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const TOOL_GROUPS = [
  { label: 'BI & Languages', tools: ['SQL', 'Python', 'Tableau', 'Power BI', 'Advanced Excel', 'dbt'] },
  { label: 'Platforms', tools: ['Snowflake', 'AWS', 'SQL Server', 'Azure', 'Git / GitHub', 'Jira / Confluence', 'Streamlit', 'Apache Airflow'] },
  { label: 'Analytics', tools: ['BRE policy logic', 'Approval-rate monitoring', 'Funnel analysis', 'A/B testing', 'Risk cohort analysis', 'EWI tracking', 'RCA'] },
  { label: 'Workflow', tools: ['BRE policy configuration', 'REST API integration', 'UAT & sanity checks', 'BRD review', 'Agile / Scrum'] },
] as const;
---

<BaseLayout title="About — Milan Behera" description="Data analyst, 4+ years in BFSI credit risk and lending analytics with cross-domain range.">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_16rem] sm:items-start">
      <div data-rise style="--rise-i:0">
        <h1 class="text-h2 font-display">About</h1>
        <p class="mt-6 max-w-[52ch] text-lead">
          I'm a data analyst with 4+ years in lending and credit risk. I turn messy operational data
          into decisions — funnels, metric definitions, root causes, dashboards.
        </p>
        <div class="mt-6 max-w-[52ch] space-y-4 text-muted">
          <p>
            Most of my work sits where written policy meets production systems. At Khatabook I own
            business-rules-engine analytics across six lending partners: translating joint credit
            policy documents into executable rule configuration, monitoring the approval funnel from
            whitelisting through disbursal, and tracking a ₹8–9B+ book for early signs of
            delinquency. Before that, at Quinte Financial Technologies, I built cohort and vintage
            delinquency analytics for Axos Bank in the US and automated the vendor-risk assessment
            that used to be done by hand.
          </p>
          <p>
            The pattern across both: define the metric properly, prove the cause with a number, and
            leave behind something that keeps working after I've moved on — a monitored dataset, a
            tested rule set, a tool other analysts use.
          </p>
          <p>
            Lending is where I'm deepest, not where I'm fenced in. I've built regression models for
            a construction firm, led a 60+ person global data team at Omdena, freelanced on Upwork
            for over a year, and I run <a href="https://theovenvibe.github.io/" class="text-accent underline">The Oven Vibe</a>,
            a D2C bakery I founded — where I'm the analyst and the one who lives with the decisions.
            The domain changes; the method doesn't.
          </p>
        </div>
        <p class="mt-6 font-mono text-sm text-muted">
          Bengaluru, India · Open to remote
        </p>
        <p class="mt-2 font-mono text-sm text-muted">
          English &amp; Hindi (full professional) · Odia (native) · Bengali (professional working)
        </p>
      </div>
      <Image
        src={photo}
        alt="Milan Behera"
        width={320}
        height={320}
        class="aspect-square w-full rounded-2xl object-cover"
      />
    </div>

    <div class="mt-section">
      <p data-reveal class="text-label mb-8 text-muted">Tools</p>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          TOOL_GROUPS.map((g) => (
            <div data-reveal>
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-accent">{g.label}</h3>
              <ul class="mt-3 space-y-1.5 text-sm text-muted">
                {g.tools.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {
      recs.length > 0 && (
        <div class="mt-section">
          <p data-reveal class="text-label mb-8 text-muted">What people say</p>
          <div class="grid gap-6 lg:grid-cols-2">
            {recs.map((r) => (
              <figure data-reveal class="rounded-2xl border-t-[3px] border-fg pt-6">
                <blockquote class="text-fg">
                  <p>&ldquo;{r.body?.trim()}&rdquo;</p>
                </blockquote>
                <figcaption class="mt-4 text-sm">
                  <span class="font-semibold">{r.data.name}</span>
                  {r.data.role && <span class="text-muted"> — {r.data.role}</span>}
                  <br />
                  <span class="text-muted">
                    {r.data.relationship}
                    {r.data.date && ` · ${r.data.date}`}
                  </span>
                  {' · '}
                  <a href={SITE.socials.linkedin} class="text-accent underline">
                    Verify on LinkedIn
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
