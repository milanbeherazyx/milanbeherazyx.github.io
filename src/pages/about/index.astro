---
// About (PRD §3.4). Bio (placeholder — Phase 4 writes full prose from a bio
// Milan supplies), photo, tools grid (all facts from content_pack.md §6,
// already approved — safe to finalize now), recommendations as typed
// pull-quotes linking to LinkedIn for verification (no screenshots).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
/* Theme-matched portraits (2026-07-29): each has a background designed for
 * one mode. Both render; CSS shows one — no JS, so no wrong-image flash. */
import photoDark from '../../assets/milan-profile-bold.png';
import photoLight from '../../assets/milan-profile-light.png';

const recs = (await getCollection('recommendations', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const TOOL_GROUPS = [
  { label: 'BI & Languages', tools: ['SQL', 'Python', 'Tableau', 'Power BI', 'Advanced Excel', 'dbt'] },
  { label: 'Platforms', tools: ['Snowflake', 'AWS', 'SQL Server', 'Azure', 'Git / GitHub', 'Jira / Confluence', 'Streamlit', 'Apache Airflow'] },
  { label: 'Analytics', tools: ['BRE policy logic', 'Approval-rate monitoring', 'Funnel analysis', 'A/B testing', 'Machine Learning', 'Risk cohort analysis', 'EWI tracking', 'RCA'] },
  { label: 'Workflow', tools: ['BRE policy configuration', 'REST API integration', 'UAT & sanity checks', 'BRD review', 'Agile / Scrum'] },
] as const;

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': `${SITE.url}/#person` },
};
---

<BaseLayout
  title="About — Milan Kumar Behera"
  description="Data analyst, 4+ years in BFSI credit risk and lending analytics with cross-domain range."
  extraSchema={profileSchema}
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_16rem] sm:items-start">
      <div data-rise style="--rise-i:0">
        <h1 class="text-h2 font-display">About</h1>
        <p class="mt-6 max-w-[52ch] text-lead">
          I'm a data analyst with 4+ years in lending and credit risk. I turn messy operational data
          into decisions — funnels, metric definitions, root causes, dashboards.
        </p>
        <div class="mt-6 max-w-[52ch] space-y-4 text-muted">
          <p>
            Most of my work sits where written policy meets production systems. At Khatabook I own
            business-rules-engine analytics across six lending partners: translating joint credit
            policy documents into executable rule configuration, monitoring the approval funnel from
            whitelisting through disbursal, and tracking a ₹8–9B+ book for early signs of
            delinquency. Before that, at Quinte Financial Technologies, I built cohort and vintage
            delinquency analytics for Axos Bank in the US and automated the vendor-risk assessment
            that used to be done by hand.
          </p>
          <p>
            The pattern across both: define the metric properly, prove the cause with a number, and
            leave behind something that keeps working after I've moved on — a monitored dataset, a
            tested rule set, a tool other analysts use.
          </p>
          <p>
            Lending is where I'm deepest, not where I'm fenced in. I've built regression models for
            a construction firm, led a 60+ person global data team at Omdena, freelanced on Upwork
            for over a year, and I run <a href="https://theovenvibe.github.io/" class="text-accent underline">The Oven Vibe</a>,
            a D2C bakery I founded — where I'm the analyst and the one who lives with the decisions.
            The domain changes; the method doesn't.
          </p>
        </div>
        <p class="mt-6 font-mono text-sm text-muted">
          Bengaluru, India · Open to remote
        </p>
        <p class="mt-2 font-mono text-sm text-muted">
          English &amp; Hindi (full professional) · Odia (native) · Bengali (professional working)
        </p>
      </div>
      <div data-reveal class="photo-frame relative overflow-hidden rounded-2xl">
        <Image
          src={photoLight}
          alt="Milan Kumar Behera"
          width={360}
          height={360}
          densities={[1, 2]}
          class="photo-light aspect-square w-full object-cover"
        />
        <Image
          src={photoDark}
          alt=""
          width={360}
          height={360}
          densities={[1, 2]}
          aria-hidden="true"
          class="photo-dark absolute inset-0 aspect-square w-full object-cover"
        />
      </div>
    </div>

    <div class="mt-section">
      <p data-reveal class="text-label mb-8 text-muted">Tools</p>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          TOOL_GROUPS.map((g, i) => (
            <div data-reveal style={i ? `transition-delay:${i * 70}ms` : undefined}>
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-accent-2">{g.label}</h3>
              <ul class="mt-3 space-y-1.5 text-sm text-muted">
                {g.tools.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {
      recs.length > 0 && (
        <div class="mt-section">
          <p data-reveal class="text-label mb-8 text-muted">What people say</p>
          <div class="grid gap-6 lg:grid-cols-2">
            {recs.map((r, i) => (
              <figure data-reveal style={i % 2 ? 'transition-delay:70ms' : undefined} class="glass lift quote-card relative p-6 pt-10 sm:p-8 sm:pt-12">
                <span class="quote-mark text-gradient" aria-hidden="true">&ldquo;</span>
                <blockquote class="text-fg">
                  <p>{r.body?.trim()}</p>
                </blockquote>
                <figcaption class="mt-4 text-sm">
                  <span class="font-semibold">{r.data.name}</span>
                  {r.data.role && <span class="text-muted"> — {r.data.role}</span>}
                  <br />
                  <span class="text-muted">
                    {r.data.relationship}
                    {r.data.date && ` · ${r.data.date}`}
                  </span>
                  {' · '}
                  <a href={SITE.socials.linkedin} class="text-accent-2 underline">
                    Verify on LinkedIn
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  /* Blend the studio-gray photo into the page instead of ringing it with a
   * glow blob (owner feedback: the v2 glow read as a harsh, unblended box
   * on the dark bg). Three quiet layers, all theme-aware: a hairline
   * border, a page-bg vignette that eats the photo's corners, and a faint
   * accent wash top-left for palette cohesion. */
  .photo-frame {
    border: 1px solid var(--line);
  }
  /* Theme-matched portraits: both render, one is shown. The selectors
     mirror global.css's mode mechanism exactly — explicit `data-theme`
     wins, otherwise the system preference decides. Crossfade so the
     header toggle doesn't hard-cut the image. */
  .photo-light,
  .photo-dark {
    transition: opacity 0.25s ease;
  }
  .photo-dark {
    opacity: 0;
  }
  :root[data-theme='dark'] .photo-light {
    opacity: 0;
  }
  :root[data-theme='dark'] .photo-dark {
    opacity: 1;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .photo-light {
      opacity: 0;
    }
    :root:not([data-theme='light']) .photo-dark {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-light,
    .photo-dark {
      transition: none;
    }
  }
  .quote-mark {
    position: absolute;
    top: -0.15em;
    left: 1.5rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-frame::before {
      filter: none;
    }
  }
</style>
