---
// Resume (PRD §3.5) — STUB. 60-second scannable timeline in Phase 3/4.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

const roles = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Resume — Milan Behera">
  <h1 class="text-3xl font-bold">Resume</h1>
  {
    roles.length === 0 ? (
      <p class="mt-4">
        Full resume page coming soon. <a href={SITE.resumePdf} class="underline">Download the PDF</a>.
      </p>
    ) : (
      <ul class="mt-6 space-y-4">
        {roles.map((r) => (
          <li>
            <strong>{r.data.role}</strong> — {r.data.company} ({r.data.start} – {r.data.end})
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
