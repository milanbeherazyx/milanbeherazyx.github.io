---
// Resume (PRD §3.5) — recruiter-optimized, scannable in ~60s. Timeline from
// the `experience` collection (facts from content_pack.md §4, resolved per
// the "resume PDF is truth" rule — see PROGRESS.md).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

const roles = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const SKILLS = ['SQL', 'Python', 'Snowflake', 'Tableau', 'Power BI', 'Advanced Excel', 'dbt', 'AWS', 'Git/GitHub'];

const EDUCATION = [
  { degree: 'B.Tech., Civil Engineering (BPUT), CGPA 8.05', school: 'Einstein Academy of Technology & Management', years: '2018 – 2021' },
  { degree: 'Diploma, Civil Engineering (SCTE&VT Odisha)', school: 'Hi-Tech Institute of Engineering & Management', years: '2010 – 2013' },
];

const CERTIFICATIONS = [
  'IBM: Machine Learning with Python',
  'IBM: Data Analysis with Python',
  'IBM: Data Science 101',
  'IBM: Statistics 101',
  'Microsoft: Excel (Advanced)',
];
---

<BaseLayout title="Resume — Milan Kumar Behera" description="Experience timeline, skills, and education — data analyst specializing in lending and credit-risk analytics.">
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div data-rise style="--rise-i:0">
        <h1 class="text-h2 font-display">Resume</h1>
        <p class="mt-3 max-w-[42ch] text-muted">Data Analyst — BRE Analytics &amp; Risk Cohorts. SQL, Python, Tableau.</p>
      </div>
      <a href={SITE.resumePdf} data-rise style="--rise-i:1" class="btn-gradient inline-block px-6 py-3 font-semibold">
        Download PDF
      </a>
    </div>

    <div class="mt-section">
      <p data-reveal class="text-label mb-8 text-muted">Experience</p>
      <ol data-reveal class="timeline relative space-y-10 pl-6 sm:pl-8">
        <span class="timeline-spine absolute left-0 top-0 h-full w-px origin-top bg-linear-to-b from-accent to-accent-2" aria-hidden="true" />
        {
          roles.map((r, i) => (
            <li data-reveal style={i ? `transition-delay:${i * 90}ms` : undefined} class="relative">
              <span class="absolute -left-6.75 top-1.5 h-2.5 w-2.5 rounded-full bg-accent-2 sm:-left-8.75" />
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="font-display text-lg font-semibold">{r.data.role} · {r.data.company}</h2>
                <span class="font-mono text-xs text-muted">{r.data.start} – {r.data.end}</span>
              </div>
              {r.data.location && <p class="mt-0.5 text-sm text-muted">{r.data.location}</p>}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-section grid gap-10 sm:grid-cols-2">
      <div data-reveal>
        <p class="text-label mb-6 text-muted">Skills</p>
        <div class="flex flex-wrap gap-2">
          {SKILLS.map((s) => (
            <span class="rounded-full border border-line px-3 py-1.5 font-mono text-xs">{s}</span>
          ))}
        </div>
      </div>
      <div data-reveal>
        <p class="text-label mb-6 text-muted">Certifications</p>
        <ul class="space-y-1.5 text-sm text-muted">
          {CERTIFICATIONS.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <div class="mt-section">
      <p data-reveal class="text-label mb-6 text-muted">Education</p>
      <div class="space-y-4">
        {
          EDUCATION.map((e) => (
            <div data-reveal class="flex flex-wrap items-baseline justify-between gap-2 border-t border-line pt-4">
              <div>
                <p class="font-medium">{e.degree}</p>
                <p class="text-sm text-muted">{e.school}</p>
              </div>
              <span class="font-mono text-xs text-muted">{e.years}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline-spine {
    transform: scaleY(0);
    transition: transform 1s var(--ease-rise);
  }
  .js .timeline.is-revealed .timeline-spine {
    transform: scaleY(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-spine {
      transform: scaleY(1) !important;
    }
  }
</style>
