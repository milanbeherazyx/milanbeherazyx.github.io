---
// Home (PRD §3.1). Hero → funnel signature → marquee → proof strip →
// featured case studies → services teaser. v2 "Signal" direction: hero
// line-mask reveal, radial glow anchor, gradient CTA, pausable marquee.
// Placeholder-tolerant: renders correctly with however many entries exist.
import BaseLayout from '../layouts/BaseLayout.astro';
import FunnelBeforeAfter from '../components/FunnelBeforeAfter.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// snake_case per the approved c-signal mock's marquee flavor
const MARQUEE_ITEMS = [
  'SQL',
  'Snowflake',
  'Tableau',
  'Python',
  'bre_policy_analytics',
  'funnel_diagnostics',
  'risk_cohorts',
  'ewi_tracking',
  'rca',
];
---

<BaseLayout>
  <section class="hero-glow relative mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8 sm:pt-20 lg:pt-28">
    <p data-rise style="--rise-i:0" class="signal-dot text-label text-accent-2">open_to_leads_&amp;_roles</p>
    <h1 class="mt-5 max-w-[13ch] text-display">
      <span class="line" style="--line-i:0"><span>Messy data,</span></span>
      <span class="line" style="--line-i:1"><span>turned into</span></span>
      <span class="line" style="--line-i:2"><span class="text-gradient">decisions.</span></span>
    </h1>
    <p data-rise style="--rise-i:3" class="mt-6 max-w-xl text-lead text-muted">
      Funnels, metrics, root causes, dashboards. Deepest in lending &amp; credit risk — the domain
      changes; the funnel math doesn't.
    </p>
    <p data-rise style="--rise-i:3" class="mt-3 font-mono text-sm text-muted">
      Deepest in: Lending &amp; Credit Risk · SQL/Snowflake · Funnels &amp; RCA
    </p>
    <div data-rise style="--rise-i:4" class="mt-8 flex flex-wrap items-center gap-4 sm:gap-6">
      <a href="/contact/" class="btn-gradient inline-block px-7 py-3.5 text-base">Book a call</a>
      <a href="/work/" class="textlink">view_case_studies →</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-section sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-16">
      <div data-reveal>
        <p class="text-label text-muted">the_flagship_number</p>
        <h2 class="mt-4 max-w-[16ch] text-h2 font-display">
          One funnel, benchmarked <span class="text-gradient">rule by rule.</span>
        </h2>
        <p class="mt-4 max-w-[40ch] text-muted">
          Portfolio qualification, indexed per 100 applications — six lending partners, 100K+
          monthly borrowers. The lift came from finding exactly which rules turned fundable
          borrowers away.
        </p>
        <a href="/work/lifting-qualification-30-to-43/" class="textlink mt-6 inline-block">
          how_the_lift_happened →
        </a>
      </div>
      <FunnelBeforeAfter
        beforeValue={30}
        afterValue={43}
        of={100}
        beforeLabel="Before — rules as first configured"
        afterLabel="After — rules benchmarked, fixed &amp; monitored"
        deltaLabel="+13 pts"
      />
    </div>
  </section>

  <div class="marquee border-y border-line py-4" aria-hidden="true">
    <div class="marquee-track font-mono text-sm text-muted">
      {
        [0, 1].map(() => (
          <span>
            {MARQUEE_ITEMS.map((item) => (
              <>
                {item} <i class="mr-13 not-italic text-accent-2">·</i>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-5 py-section sm:px-8">
    <ProofStrip />
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 py-section sm:px-8">
        <p data-reveal class="text-label mb-8 text-muted">
          selected_work/
        </p>
        {/* Feature treatment per DIRECTION_SPEC: first card larger — the
            mock's 1.35fr/1fr split, with the feature card spanning both
            rows so the remaining two stack beside it. */}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-[1.35fr_1fr]">
          {featured.map((cs, i) => (
            <div class:list={[i === 0 && 'sm:max-lg:col-span-2 lg:row-span-2']}>
              <CaseStudyCard
                href={`/work/${cs.id}/`}
                title={cs.data.title}
                summary={cs.data.summary}
                tags={cs.data.tags}
                metric={cs.data.metrics?.[0]}
                index={i + 1}
                delay={i * 60}
                featured={i === 0}
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    services.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 py-section sm:px-8">
        <p data-reveal class="text-label mb-8 text-muted">
          services/
        </p>
        <div class="grid gap-6 sm:grid-cols-3">
          {services.slice(0, 3).map((s, i) => (
            <a href="/services/" data-reveal style={i ? `transition-delay:${i * 60}ms` : undefined} class="glass lift block p-6">
              <h3 class="font-display text-lg font-semibold">{s.data.title}</h3>
              <p class="mt-2 text-sm text-muted">{s.data.summary}</p>
            </a>
          ))}
        </div>
        <a href="/services/" class="textlink mt-8 inline-block">see_all_services →</a>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pb-section sm:px-8">
    <div data-reveal class="cta-band glass relative flex flex-wrap items-center justify-between gap-6 overflow-hidden p-8 sm:p-12">
      <h2 class="max-w-[18ch] text-h2 font-display">
        Got a funnel that leaks? <span class="text-gradient">Let's find where.</span>
      </h2>
      <a href="/contact/" class="btn-gradient inline-block px-7 py-3.5 text-base">Book a call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-glow::before {
    content: '';
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: min(70rem, 96vw);
    height: 42rem;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 16%, transparent),
      color-mix(in srgb, #a855f7 6%, transparent) 55%,
      transparent 75%
    );
    pointer-events: none;
    z-index: -1;
  }
  .signal-dot {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .signal-dot::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 12px var(--accent-2);
  }
  /* :global(.js) — plain `.js` here would be scoped with this component's
   * [data-astro-cid-*] and never match <html class="js"> (G3 bug class). */
  :global(.js) .signal-dot::before {
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }
  .cta-band::before {
    content: '';
    position: absolute;
    left: 20%;
    top: -80%;
    width: min(34rem, 70vw);
    height: 22rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .signal-dot::before {
      animation: none !important;
    }
  }
</style>
