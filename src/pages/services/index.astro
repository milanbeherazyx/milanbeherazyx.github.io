---
// Services (PRD §3.3). Domain-agnostic offers + "how I ramp on a new
// domain" block (directly answers the versatility claim with a process).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

const entries = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const offers = await Promise.all(
  entries.map(async (o) => ({ data: o.data, Content: (await render(o)).Content })),
);

/* SEO (owner directive 2026-07-28): freelance services are offered
 * remotely, worldwide — surface that as structured data so the page can
 * match service-intent queries, not just name searches. */
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Data analytics services — Milan Kumar Behera',
  url: `${SITE.url}/services/`,
  itemListElement: offers.map(({ data }) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: data.title,
      description: data.summary,
      provider: { '@id': `${SITE.url}/#person` },
      serviceType: 'Data analytics consulting',
      areaServed: 'Worldwide',
    },
  })),
};

const RAMP_STEPS = [
  { step: '1', label: 'Docs', detail: 'Share what exists — policy docs, schema, dashboards, whatever is already written down.' },
  { step: '2', label: 'Metric definitions', detail: 'Agree what each number actually means before analyzing it — this is where most analytics work goes wrong.' },
  { step: '3', label: 'KT call', detail: 'One short call to fill the gaps docs can\'t — a walkthrough, not a workshop.' },
  { step: '4', label: 'First analysis, week 1', detail: 'A concrete first finding inside the first week, not a discovery-phase deck.' },
] as const;
---

<BaseLayout
  title="Services — Milan Kumar Behera"
  description="Freelance data analytics services, remote & worldwide — funnel diagnostics, Tableau & Power BI dashboards, policy analytics, root-cause analysis."
  extraSchema={servicesSchema}
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 data-rise style="--rise-i:0" class="text-h2 font-display">Services</h1>
    <p data-rise style="--rise-i:1" class="mt-4 max-w-[46ch] text-lead text-muted">
      Domain-agnostic offers, proven deepest in lending. Every engagement starts with a short
      intro call.
    </p>

    {
      offers.length > 0 && (
        <div class="mt-12 grid gap-8 lg:grid-cols-2">
          {offers.map(({ data, Content }, i) => (
            <article data-reveal style={i % 2 ? 'transition-delay:70ms' : undefined} class="glass lift relative p-6 pt-7 sm:p-8 sm:pt-9">
              <span class="rule-draw absolute inset-x-0 top-0 h-0.5 origin-left bg-linear-to-r from-accent to-accent-2" />
              <h2 class="font-display text-xl font-semibold">{data.title}</h2>
              <p class="mt-3 font-medium text-accent-2">{data.summary}</p>
              <div class="service-body mt-4">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div data-reveal class="glass beam mt-section p-6 sm:p-10">
      <p class="text-label text-accent-2">How I ramp on a new domain</p>
      <h2 class="mt-3 max-w-[28ch] text-h2 font-display">
        The versatility claim, answered with a process — not an assertion.
      </h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {RAMP_STEPS.map((s) => (
          <li data-reveal class="flex flex-col gap-2">
            <span class="font-mono text-sm text-gradient font-semibold">Step {s.step}</span>
            <span class="font-display text-lg font-semibold">{s.label}</span>
            <span class="text-sm text-muted">{s.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-section">
      <p class="text-label text-muted">Engagement models</p>
      <p class="mt-3 max-w-[46ch] text-muted">
        Project · Retainer · Audit — we scope the engagement together on the intro call.
      </p>
      <a href="/contact/" class="btn-gradient mt-6 inline-block px-7 py-3.5 font-semibold">
        Book a call
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-body :global(p) {
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 0.85rem;
    font-size: 0.97rem;
  }
  .service-body :global(strong) {
    color: var(--fg);
  }
  .service-body :global(em) {
    font-style: italic;
  }
</style>
