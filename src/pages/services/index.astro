---
// Services (PRD §3.3). Domain-agnostic offers + "how I ramp on a new
// domain" block (directly answers the versatility claim with a process).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const offers = await Promise.all(
  entries.map(async (o) => ({ data: o.data, Content: (await render(o)).Content })),
);

const RAMP_STEPS = [
  { step: '1', label: 'Docs', detail: 'Share what exists — policy docs, schema, dashboards, whatever is already written down.' },
  { step: '2', label: 'Metric definitions', detail: 'Agree what each number actually means before analyzing it — this is where most analytics work goes wrong.' },
  { step: '3', label: 'KT call', detail: 'One short call to fill the gaps docs can\'t — a walkthrough, not a workshop.' },
  { step: '4', label: 'First analysis, week 1', detail: 'A concrete first finding inside the first week, not a discovery-phase deck.' },
] as const;
---

<BaseLayout title="Services — Milan Behera" description="Domain-agnostic data analytics services — funnel diagnostics, dashboards & QA, policy analytics, root-cause analysis.">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 data-rise style="--rise-i:0" class="text-h2 font-display">Services</h1>
    <p data-rise style="--rise-i:1" class="mt-4 max-w-[46ch] text-lead text-muted">
      Domain-agnostic offers, proven deepest in lending. No public pricing — every engagement
      starts with a short KT call.
    </p>

    {
      offers.length > 0 && (
        <div class="mt-12 grid gap-10 lg:grid-cols-2">
          {offers.map(({ data, Content }) => (
            <article data-reveal class="rounded-2xl border-t-[3px] border-fg pt-6">
              <h2 class="font-display text-xl font-semibold">{data.title}</h2>
              <p class="mt-3 font-medium text-muted">{data.summary}</p>
              <div class="service-body mt-4">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div class="mt-section rounded-2xl border border-line p-6 sm:p-10">
      <p class="text-label text-accent">How I ramp on a new domain</p>
      <h2 class="mt-3 max-w-[28ch] text-h2 font-display">
        The versatility claim, answered with a process — not an assertion.
      </h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {RAMP_STEPS.map((s) => (
          <li data-reveal class="flex flex-col gap-2">
            <span class="font-mono text-sm text-muted">Step {s.step}</span>
            <span class="font-display text-lg font-semibold">{s.label}</span>
            <span class="text-sm text-muted">{s.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-section">
      <p class="text-label text-muted">Engagement models</p>
      <p class="mt-3 max-w-[46ch] text-muted">Project · Retainer · Audit — scoped on the KT call, no public pricing in v1.</p>
      <a
        href="/contact/"
        class="mt-6 inline-block rounded-full bg-accent px-7 py-3.5 font-semibold text-accent-contrast transition-transform duration-200 hover:-translate-y-0.5"
      >
        Book a call
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-body :global(p) {
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 0.85rem;
    font-size: 0.97rem;
  }
  .service-body :global(strong) {
    color: var(--fg);
  }
  .service-body :global(em) {
    font-style: italic;
  }
</style>
