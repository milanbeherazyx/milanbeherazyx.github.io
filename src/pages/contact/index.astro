---
// Contact (PRD §3.6, amended 2026-07-29: Cal.com cancelled by Milan — the
// primary conversion path is the Web3Forms form + direct email; intro calls
// are scheduled over email). The form renders only when
// SITE.web3formsKey is set; until then the page degrades to mailto CTAs
// with zero code changes needed later.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

const hasForm = SITE.web3formsKey.length > 0;

/* FAQ (v2.1-S5) — answers from approved page copy. */
const FAQS = [
  {
    q: 'How quickly will you reply?',
    a: 'Within a day. I read everything myself.',
  },
  {
    q: 'What happens on the intro call?',
    a: "Thirty minutes, no obligation. You describe the problem; we work out whether it's a project, a retainer, or an audit — and what a first week of work would look like.",
  },
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Contact — Milan Kumar Behera"
  description="Send a message or book a 30-minute intro call over email — data analytics consulting for lending, credit risk, and any data-generating business."
  extraSchema={faqSchema}
>
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 data-rise style="--rise-i:0" class="text-h2 font-display">Let's talk</h1>
    <p data-rise style="--rise-i:1" class="mt-4 max-w-[46ch] text-lead text-muted">
      Send a message with a bit of context, or email me directly to set up a 30-minute intro call —
      I read everything myself and reply within a day.
    </p>

    <div class="mt-section grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <div data-reveal>
        <p class="text-label mb-4 text-muted">Send a message</p>
        {
          hasForm ? (
            <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
              <input type="hidden" name="access_key" value={SITE.web3formsKey} />
              <input type="hidden" name="subject" value="New message via milanbeherazyx.github.io" />
              <input type="hidden" name="from_name" value="Portfolio contact form" />
              <input type="hidden" name="redirect" value={`${SITE.url}/thanks/`} />
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none"
                tabindex="-1"
                aria-hidden="true"
              />
              <div>
                <label for="name" class="text-sm font-medium">Name</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="field mt-1 w-full rounded-lg border border-line bg-surface px-4 py-3"
                />
              </div>
              <div>
                <label for="email" class="text-sm font-medium">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="field mt-1 w-full rounded-lg border border-line bg-surface px-4 py-3"
                />
              </div>
              <div>
                <label for="message" class="text-sm font-medium">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows={6}
                  required
                  placeholder="A line about your company, your data stack, and the problem you're looking at."
                  class="field mt-1 w-full rounded-lg border border-line bg-surface px-4 py-3"
                />
              </div>
              <button type="submit" class="btn-gradient px-7 py-3.5 font-semibold">
                Send message
              </button>
            </form>
          ) : (
            <div class="rounded-2xl border border-dashed border-line p-8 text-center">
              <p class="text-muted">The contact form is being set up.</p>
              <a href={`mailto:${SITE.email}`} class="btn-gradient mt-4 inline-block break-all px-6 py-3 font-semibold">
                {SITE.email}
              </a>
            </div>
          )
        }
      </div>

      <div data-reveal class="flex flex-col gap-8">
        <div>
          <p class="text-label mb-3 text-muted">Book an intro call</p>
          <p class="text-muted">
            30 minutes, no obligation. Email me two or three slots that work for you and I'll
            confirm one.
          </p>
          <a
            href={`mailto:${SITE.email}?subject=Intro call`}
            class="mt-4 inline-block border-b-2 border-fg pb-1 font-semibold hover:border-accent-2 hover:text-accent-2"
          >
            {SITE.email}
          </a>
        </div>
        <div>
          <p class="text-label mb-3 text-muted">Elsewhere</p>
          <ul class="space-y-2 text-muted">
            <li><a href={SITE.socials.linkedin} class="hover:text-accent-2">LinkedIn — fastest for recruiters</a></li>
            <li><a href={SITE.socials.github} class="hover:text-accent-2">GitHub</a></li>
            <li><a href={SITE.socials.x} class="hover:text-accent-2">X</a></li>
            <li><a href={SITE.resumePdf} class="hover:text-accent-2">Resume (PDF)</a></li>
          </ul>
        </div>
        <div>
          <p class="text-label mb-3 text-muted">faq/</p>
          <div class="border-y border-line">
            {
              FAQS.map((f) => (
                <details class="faq-item group border-b border-line py-4 last:border-b-0">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold">
                    {f.q}
                    <span class="shrink-0 font-mono text-lg text-accent-2 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p class="mt-2 text-sm text-muted">{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .field {
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .field:focus {
    outline: none;
    border-color: var(--accent-2);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 20%, transparent);
  }
  /* Safari renders its own disclosure triangle despite list-none */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
